{
    "name": "anytech/silverstripe-google-reviews",
    "description": "elemental block for silverstripe 6 to import and display google reviews using the places api v1",
    "type": "silverstripe-vendormodule",
    "license": "MIT",
    "authors": [
        {
            "name": "Kayne Middleton",
            "email": "kayne@anytech.ca"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "silverstripe/framework": "^6.1",
        "silverstripe/siteconfig": "^6",
        "silverstripe/vendor-plugin": "^3",
        "dnadesign/silverstripe-elemental": "^6",
        "silverstripe/crontask": "^4"
    },
    "autoload": {
        "psr-4": {
            "anytech\\googlereviews\\": "src/"
        }
    },
    "extra": {
        "expose": [
            "client/css"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
